<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#">
  <owl:Ontology rdf:about="https://example.org/conformance/ontology">
    <rdfs:label xml:lang="EN">Conformance</rdfs:label>
  </owl:Ontology>
  <owl:Class rdf:about="https://example.org/conformance#A">
    <rdfs:label xml:lang="EN">Alpha</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/conformance#B"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/conformance#B"/>
</rdf:RDF>
