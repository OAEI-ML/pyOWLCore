@prefix : <https://example.org/conformance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.org/conformance/ontology> a owl:Ontology ;
    rdfs:label "Conformance"@EN .

:A a owl:Class ;
    rdfs:label "Alpha"@EN ;
    rdfs:subClassOf :B .

:B a owl:Class .
